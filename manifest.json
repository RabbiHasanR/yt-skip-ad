{
  "manifest_version": 3,
  "name": "Skip Ad for YouTube",
  "version": "1.0.0",
  "description": "Clicks YouTube's Skip Ad button for you. Collects no data: no tracking, no network requests, open source.",
  "homepage_url": "https://github.com/RabbiHasanR/yt-skip-ad",
  "key": "",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/trusted-click.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/**/*.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
