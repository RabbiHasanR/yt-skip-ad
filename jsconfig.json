{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.js",
    "popup/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js"
  ]
}
